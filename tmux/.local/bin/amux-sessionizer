#!/usr/bin/env bash
set -euo pipefail

if [[ $# -gt 0 ]]; then
    selected="$*"
else
    selected=$(
        { tmux list-sessions -f '#{==:#{@amux-sessionizer},1}' -F '#{session_name}' 2>/dev/null || true; } |
            fzf --no-multi --prompt='amux> ' \
                --header='Enter: open or create | Ctrl-N: create typed name | Esc: cancel' \
                --preview '
                    session_name={}
                    session_id=$(tmux show-options -qv -t "=$session_name:" @amux-session-id 2>/dev/null) || exit 0
                    if [ -z "$session_id" ]; then
                        printf "Open this session once to enable its nugget summary.\n"
                    elif command -v nug >/dev/null 2>&1; then
                        AMUX_SESSION_ID="$session_id" NUGGET_SESSION_ID="$session_id" nug session view
                    else
                        printf "Install nugget to preview this session.\n"
                    fi
                ' \
                --preview-window='down,67%,wrap' \
                --bind='enter:accept-or-print-query,ctrl-n:print-query'
    ) || exit 0
fi

if [[ -z ${selected//[[:space:]]/} ]]; then
    exit 0
fi

selected=${selected//[.:]/_}

if ! tmux has-session -t "=$selected" 2>/dev/null; then
    session_id=$(python3 -c 'import uuid; print(uuid.uuid4())')
    tmux new-session -d -s "$selected" -c "$PWD" \
        -e "AMUX_SESSION_ID=$session_id" -e "NUGGET_SESSION_ID=$session_id" \; \
        set-option -t "=$selected:" @amux-sessionizer 1 \; \
        set-option -t "=$selected:" @amux-session-id "$session_id"
elif [[ $(tmux show-options -qv -t "=$selected:" @amux-sessionizer) != 1 ]]; then
    printf 'amux-sessionizer: "%s" is already used by a non-amux session. Choose another name.\n' "$selected" >&2
    exit 1
else
    session_id=$(tmux show-options -qv -t "=$selected:" @amux-session-id)
    if [[ -z $session_id ]]; then
        session_id=$(python3 -c 'import uuid; print(uuid.uuid4())')
        tmux set-option -t "=$selected:" @amux-session-id "$session_id"
    fi
fi

tmux set-environment -t "=$selected:" AMUX_SESSION_ID "$session_id" \; \
    set-environment -t "=$selected:" NUGGET_SESSION_ID "$session_id" \; \
    set-window-option -t "=$selected:" automatic-rename on \; \
    set-window-option -t "=$selected:" allow-rename off \; \
    set-option -t "=$selected:" set-titles on \; \
    set-option -t "=$selected:" set-titles-string '#{session_name}'

if [[ -z ${TMUX:-} ]]; then
    exec tmux attach-session -t "=$selected"
else
    exec tmux switch-client -t "=$selected"
fi
