#!/usr/bin/env bash

# Pins individual KDE settings that live in config files too noisy to stow, and
# refreshes the caches Plasma reads desktop entries out of.
#
# Most KDE config is symlinked straight into this repo (see kde/.config/), which
# works because KConfig writes through symlinks. kdeglobals is the exception:
# Plasma rewrites it during ordinary use — colour scheme data, widget style, and
# a [KFileDialog Settings] block that records file-dialog sort order and
# geometry — so stowing it would bury real settings in churn.
#
# Add a kwriteconfig6 line here for each key worth keeping. Re-run any time
# after fiddling in System Settings to snap the pinned keys back.

set -e

# Terminal used by "Open Terminal Here" in Dolphin and friends
kwriteconfig6 --file kdeglobals --group General --key TerminalApplication \
  "/usr/bin/ghostty --gtk-single-instance=true"

# macOS-style "natural" scrolling: content follows the fingers instead of the
# scrollbar. kcminputrc keys each device separately, so discover every pointer
# attached right now — a "mouse" handler is the kernel's own marker for one —
# and pin them all. That covers whatever this machine happens to have: touchpad,
# TrackPoint, the virtual pointer keyd interposes, an external mouse.
while IFS= read -r line; do
  case "$line" in
    "I: "*)
      vendor=${line#*Vendor=}; vendor=${vendor%% *}
      product=${line#*Product=}; product=${product%% *}
      ;;
    'N: Name="'*)
      name=${line#N: Name=\"}; name=${name%\"}
      ;;
    "H: Handlers="*mouse*)
      # Vendor and product are hex in procfs but decimal in kcminputrc
      kwriteconfig6 --file kcminputrc \
        --group Libinput --group "$((16#$vendor))" --group "$((16#$product))" \
        --group "$name" --key NaturalScroll true
      echo "Natural scrolling: $name"
      ;;
  esac
done < /proc/bus/input/devices

# Pick up the .desktop overrides in kde/.local/share/applications/. Without
# this, newly stowed entries stay invisible to Plasma and windows they exist to
# fix keep showing the generic Wayland icon.
update-desktop-database "$HOME/.local/share/applications"
kbuildsycoca6 --noincremental

echo "Applied KDE settings"
